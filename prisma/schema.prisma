/// Configurable master of service work types. Deactivation preserves the row so
/// historical requests keep their original work type name.
model ServiceWorkType {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  defaultTargetDays Int?     @map("default_target_days")
  isActive          Boolean  @default(true) @map("is_active")
  displayOrder      Int      @default(0) @map("display_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  serviceRequests ServiceRequest[]

  @@map("service_work_types")
}

/// A customer service request. Customer information is stored directly here with
/// no foreign key to Customer, Project, Lead, Quotation, or Proposal (see PRD §2).
model ServiceRequest {
  id                    String                         @id @default(uuid()) @db.Uuid
  serviceRequestNumber  String                         @unique @map("service_request_number")
  companyId             String                         @map("company_id") @db.Uuid
  customerName          String                         @map("customer_name")
  mobileNumber          String?                        @map("mobile_number")
  alternateMobileNumber String?                        @map("alternate_mobile_number")
  consumerNumber        String?                        @map("consumer_number")
  installationAddress   String?                        @map("installation_address")
  cityOrVillage         String?                        @map("city_or_village")
  landmark              String?
  workTypeId            String?                        @map("work_type_id") @db.Uuid
  customWorkType        String?                        @map("custom_work_type")
  customerRequest       String                         @map("customer_request")
  priority              ServicePriority                @default(NORMAL)
  status                ServiceStatus                  @default(OPEN)
  waitingReason         ServiceWaitingReason?          @map("waiting_reason")
  assignedToUserId      String?                        @map("assigned_to_user_id") @db.Uuid
  requestDate           DateTime                       @map("request_date")
  targetCompletionDate  DateTime?                      @map("target_completion_date") @db.Date
  nextActionDate        DateTime?                      @map("next_action_date") @db.Date
  systemStatus          ServiceSystemStatus            @default(NOT_CHECKED) @map("system_status")
  complaintSource       ServiceComplaintSource?        @map("complaint_source")
  isChargeable          Boolean                        @default(false) @map("is_chargeable")
  totalFees             Decimal                        @default(0) @map("total_fees") @db.Decimal(12, 2)
  amountReceived        Decimal                        @default(0) @map("amount_received") @db.Decimal(12, 2)
  pendingAmount         Decimal                        @default(0) @map("pending_amount") @db.Decimal(12, 2)
  completionDate        DateTime?                      @map("completion_date") @db.Date
  completionNotes       String?                        @map("completion_notes")
  systemStatusAfterWork ServiceCompletionSystemStatus? @map("system_status_after_work")
  customerConfirmation  ServiceCustomerConfirmation?   @map("customer_confirmation")
  furtherWorkRequired   Boolean                        @default(false) @map("further_work_required")
  closedDate            DateTime?                      @map("closed_date") @db.Date
  cancellationReason    String?                        @map("cancellation_reason")
  reopenedReason        String?                        @map("reopened_reason")
  internalNote          String?                        @map("internal_note")
  importReference       String?                        @map("import_reference")
  createdByUserId       String                         @map("created_by") @db.Uuid
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  workType    ServiceWorkType?    @relation(fields: [workTypeId], references: [id])
  assignedTo  User?               @relation("ServiceAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy   User                @relation("ServiceCreatedBy", fields: [createdByUserId], references: [id])
  updates     ServiceUpdate[]
  attachments ServiceAttachment[]
  payments    ServicePayment[]

  @@index([companyId, status])
  @@index([mobileNumber])
  @@index([consumerNumber])
  @@index([assignedToUserId])
  @@index([requestDate])
  @@index([targetCompletionDate])
  @@map("service_requests")
}

/// Append-only activity timeline entry for a service request. Records both user
/// updates and system events (status change, assignment, payment, completion).
model ServiceUpdate {
  id                  String                @id @default(uuid()) @db.Uuid
  serviceRequestId    String                @map("service_request_id") @db.Uuid
  updateType          ServiceUpdateType     @map("update_type")
  note                String?
  oldStatus           ServiceStatus?        @map("old_status")
  newStatus           ServiceStatus?        @map("new_status")
  waitingReason       ServiceWaitingReason? @map("waiting_reason")
  nextActionDate      DateTime?             @map("next_action_date") @db.Date
  visitDate           DateTime?             @map("visit_date") @db.Date
  visitTime           String?               @map("visit_time")
  visitStatus         ServiceVisitStatus?   @map("visit_status")
  visitResult         String?               @map("visit_result")
  contactMode         ServiceContactMode?   @map("contact_mode")
  materialDetails     String?               @map("material_details")
  furtherWorkRequired Boolean?              @map("further_work_required")
  assignedExecutiveId String?               @map("assigned_executive_id") @db.Uuid
  oldAssignedToUserId String?               @map("old_assigned_to_user_id") @db.Uuid
  createdByUserId     String                @map("created_by") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at")

  serviceRequest    ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  assignedExecutive User?               @relation("ServiceUpdateAssignedExecutive", fields: [assignedExecutiveId], references: [id])
  createdBy         User                @relation("ServiceUpdateCreatedBy", fields: [createdByUserId], references: [id])
  attachments       ServiceAttachment[]

  @@index([serviceRequestId, createdAt])
  @@map("service_updates")
}

model ServiceAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  serviceRequestId String   @map("service_request_id") @db.Uuid
  serviceUpdateId  String?  @map("service_update_id") @db.Uuid
  fileUrl          String   @map("file_url")
  fileName         String?  @map("file_name")
  attachmentType   String?  @map("attachment_type")
  uploadedByUserId String   @map("uploaded_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceUpdate  ServiceUpdate? @relation(fields: [serviceUpdateId], references: [id], onDelete: SetNull)
  uploadedBy     User           @relation("ServiceAttachmentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([serviceRequestId])
  @@index([serviceUpdateId])
  @@map("service_attachments")
}

/// Append-only payment record for a chargeable service request.
model ServicePayment {
  id               String             @id @default(uuid()) @db.Uuid
  serviceRequestId String             @map("service_request_id") @db.Uuid
  amount           Decimal            @db.Decimal(12, 2)
  paymentMode      ServicePaymentMode @map("payment_mode")
  paymentDate      DateTime           @map("payment_date") @db.Date
  reference        String?
  recordedByUserId String             @map("recorded_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  recordedBy     User           @relation("ServicePaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([serviceRequestId])
  @@map("service_payments")
}

