model Company {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  code                String   @unique
  logoUrl             String?  @map("logo_url")
  digitalSignatureUrl String?  @map("digital_signature_url")
  address             String?
  city                String?
  state               String?
  pincode             String?
  phone               String?
  email               String?
  gstNumber           String?  @map("gst_number")
  tagline             String?
  bankDetails         String?  @map("bank_details")
  termsAndConditions  String?  @map("terms_and_conditions")
  /// HH:mm local cut-off for ready-stock same-day dispatch (e.g. "15:00"). Null = preserve legacy behaviour.
  dispatchCutoffTime  String?  @map("dispatch_cutoff_time")
  /// Opening Stock Audit gate: ops blocked while IN_PROGRESS until all warehouses approved.
  inventoryOpeningPhase      InventoryOpeningPhase @default(NOT_STARTED) @map("inventory_opening_phase")
  inventoryTrackingStartDate DateTime?             @map("inventory_tracking_start_date")
  /// Sandbox company used only while Learning Mode is on. Never use for real ops.
  isPractice          Boolean  @default(false) @map("is_practice")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  warehouses            Warehouse[]
  userCompanies         UserCompany[]
  inventoryLots         InventoryLot[]
  inventoryTransactions InventoryTransaction[]
  inventoryEvents       InventoryEvent[]
  inventorySafetyStock  InventorySafetyStock[]
  workingDays           CompanyWorkingDay[]
  holidays              CompanyHoliday[]
  transfersFrom         InventoryTransfer[]    @relation("TransferFromCompany")
  transfersTo           InventoryTransfer[]    @relation("TransferToCompany")
  crossCompanyPlansFrom PiCrossCompanyTransferPlan[] @relation("CrossCompanyPlanFrom")
  crossCompanyPlansTo   PiCrossCompanyTransferPlan[] @relation("CrossCompanyPlanTo")
  quotations            Quotation[]
  quotationWarningLogs  QuotationWarningLog[]
  proformaInvoices      ProformaInvoice[]
  payments              Payment[]
  dispatches            Dispatch[]
  invoiceHandovers      InvoiceHandover[]
  documentationRecords  DocumentationRecord[]
  projectProposals      ProjectProposal[]
  serviceRequests       ServiceRequest[]
  openingAudits         InventoryOpeningAudit[]
  dailyAudits           InventoryDailyAudit[]
  damageReports         InventoryDamageReport[]
  incomingLotChanges    IncomingLotChangeRequest[]
  purchaseRequests      PurchaseRequest[]
  manualStockEntries    ManualStockEntry[]

  @@map("companies")
}

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  name                   String
  email                  String     @unique
  mobile                 String?
  officialContactNumber  String?    @map("official_contact_number")
  personalContactNumber  String?    @map("personal_contact_number")
  digitalVisitingCardUrl String?    @map("digital_visiting_card_url")
  passwordHash           String     @map("password_hash")
  mustChangePassword     Boolean    @default(true) @map("must_change_password")
  passwordChangedAt      DateTime?  @map("password_changed_at")
  failedLoginAttempts    Int        @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?  @map("locked_until")
  status                 UserStatus @default(ACTIVE)
  learningPromptDismissedAt DateTime? @map("learning_prompt_dismissed_at")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  roles                             UserRole[]
  companies                         UserCompany[]
  learningProgress                  LearningProgress[]
  auditLogs                         AuditLog[]                     @relation("AuditPerformedBy")
  notifications                     Notification[]
  assignedCustomers                 Customer[]                     @relation("AssignedSalesExecutive")
  createdCustomers                  Customer[]                     @relation("CustomerCreatedBy")
  updatedCustomers                  Customer[]                     @relation("CustomerUpdatedBy")
  createdLots                       InventoryLot[]                 @relation("LotCreatedBy")
  inventoryTransactions             InventoryTransaction[]         @relation("TransactionCreatedBy")
  createdTransfers                  InventoryTransfer[]            @relation("TransferCreatedBy")
  dispatchedTransfers               InventoryTransfer[]            @relation("TransferDispatchedBy")
  receivedTransfers                 InventoryTransfer[]            @relation("TransferReceivedBy")
  approvedTransfers                 InventoryTransfer[]            @relation("TransferApprovedBy")
  crossCompanyPlansRequested        PiCrossCompanyTransferPlan[]   @relation("CrossCompanyPlanRequestedBy")
  crossCompanyPlansApproved         PiCrossCompanyTransferPlan[]   @relation("CrossCompanyPlanApprovedBy")
  salesQuotations                   Quotation[]                    @relation("QuotationSalesUser")
  salesProformaInvoices             ProformaInvoice[]              @relation("ProformaSalesUser")
  bookedProformaInvoices            ProformaInvoice[]              @relation("ProformaBookedBy")
  dispatchTodayMarkedPis            ProformaInvoice[]              @relation("ProformaDispatchTodayMarkedBy")
  creditRequestedProformaInvoices   ProformaInvoice[]              @relation("ProformaCreditRequestedBy")
  creditSmApprovedProformaInvoices  ProformaInvoice[]              @relation("ProformaCreditSmApprovedBy")
  creditAccountsApprovedProformaInvoices ProformaInvoice[]         @relation("ProformaCreditAccountsApprovedBy")
  recordedPayments                  Payment[]                      @relation("PaymentRecordedBy")
  createdDispatches                 Dispatch[]                     @relation("DispatchCreatedBy")
  dispatchedOrders                  Dispatch[]                     @relation("DispatchDispatchedBy")
  approvalRequests                  ApprovalRequest[]              @relation("ApprovalRequestedBy")
  approvalDecisions                 ApprovalRequest[]              @relation("ApprovalDecidedBy")
  salesProjectProposals             ProjectProposal[]              @relation("ProjectProposalSalesUser")
  createdProjectProposals           ProjectProposal[]              @relation("ProjectProposalCreatedBy")
  updatedProjectProposals           ProjectProposal[]              @relation("ProjectProposalUpdatedBy")
  convertedProjectProposals         ProjectProposal[]              @relation("ProjectProposalConvertedBy")
  createdProjectProposalRevisions   ProjectProposalRevision[]      @relation("ProjectProposalRevisionCreatedBy")
  updatedProjectProposalRevisions   ProjectProposalRevision[]      @relation("ProjectProposalRevisionUpdatedBy")
  projectProposalStatusChanges      ProjectProposalStatusHistory[] @relation("ProjectProposalStatusChangedBy")
  projectProposalApprovalsRequested ProjectProposalApproval[]      @relation("ProjectProposalApprovalRequestedBy")
  projectProposalApprovalsDecided   ProjectProposalApproval[]      @relation("ProjectProposalApprovalDecidedBy")
  assignedServiceRequests           ServiceRequest[]               @relation("ServiceAssignedTo")
  createdServiceRequests            ServiceRequest[]               @relation("ServiceCreatedBy")
  serviceUpdatesAssigned            ServiceUpdate[]                @relation("ServiceUpdateAssignedExecutive")
  serviceUpdatesCreated             ServiceUpdate[]                @relation("ServiceUpdateCreatedBy")
  serviceAttachmentsUploaded        ServiceAttachment[]            @relation("ServiceAttachmentUploadedBy")
  servicePaymentsRecorded           ServicePayment[]               @relation("ServicePaymentRecordedBy")
  inventoryEventsCreated            InventoryEvent[]               @relation("InventoryEventCreatedBy")
  inventoryEventsUpdated            InventoryEvent[]               @relation("InventoryEventUpdatedBy")
  safetyStockCreated                InventorySafetyStock[]         @relation("SafetyStockCreatedBy")
  safetyStockUpdated                InventorySafetyStock[]         @relation("SafetyStockUpdatedBy")
  quotationWarningsProceeded        QuotationWarningLog[]          @relation("QuotationWarningProceededBy")
  invoiceHandoversRecorded          InvoiceHandover[]              @relation("InvoiceHandoverRecordedBy")
  documentationAssigned             DocumentationRecord[]          @relation("DocumentationAssignedTo")
  documentationCompleted            DocumentationRecord[]          @relation("DocumentationCompletedBy")
  documentationStatusChanges        DocumentationStatusHistory[]   @relation("DocumentationStatusChangedBy")
  documentationAssignments          DocumentationAssignmentHistory[] @relation("DocumentationAssignmentChangedBy")
  openingAuditsCreated              InventoryOpeningAudit[]        @relation("OpeningAuditCreatedBy")
  openingAuditsSubmitted            InventoryOpeningAudit[]        @relation("OpeningAuditSubmittedBy")
  openingAuditsApproved             InventoryOpeningAudit[]        @relation("OpeningAuditApprovedBy")
  dailyAuditsCreated                InventoryDailyAudit[]          @relation("DailyAuditCreatedBy")
  dailyAuditsSubmitted              InventoryDailyAudit[]          @relation("DailyAuditSubmittedBy")
  damageReportsRequested            InventoryDamageReport[]        @relation("DamageReportRequestedBy")
  damageReportsDecided              InventoryDamageReport[]        @relation("DamageReportDecidedBy")
  incomingLotChangesRequested       IncomingLotChangeRequest[]     @relation("IncomingLotChangeRequestedBy")
  incomingLotChangesDecided         IncomingLotChangeRequest[]     @relation("IncomingLotChangeDecidedBy")
  purchaseRequestsRequested         PurchaseRequest[]              @relation("PurchaseRequestRequestedBy")
  purchaseRequestsUpdated           PurchaseRequest[]              @relation("PurchaseRequestUpdatedBy")
  manualStockEntriesCreated         ManualStockEntry[]             @relation("ManualStockEntryCreatedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserCompany {
  userId    String @map("user_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_companies")
}

/// Checklist completion for Learning Mode lessons (practice-company actions or tours).
model LearningProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  lessonId    String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("learning_progress")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id])
  inventoryLots        InventoryLot[]
  inventorySerials     InventorySerial[]
  inventoryEvents      InventoryEvent[]
  inventorySafetyStock InventorySafetyStock[]
  workingDayOverrides  WarehouseWorkingDay[]
  holidayOverrides     WarehouseHoliday[]
  proformaInvoices     ProformaInvoice[]
  dispatches           Dispatch[]
  openingAudits        InventoryOpeningAudit[]
  dailyAudits          InventoryDailyAudit[]
  damageReports        InventoryDamageReport[]
  purchaseRequests     PurchaseRequest[]
  manualStockEntries   ManualStockEntry[]

  @@unique([companyId, name])
  @@map("warehouses")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  tableName   String      @map("table_name")
  recordId    String      @map("record_id") @db.Uuid
  action      AuditAction
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
  performedBy String?     @map("performed_by") @db.Uuid
  performedAt DateTime    @default(now()) @map("performed_at")
  companyId   String?     @map("company_id") @db.Uuid
  reference   String?

  performer User? @relation("AuditPerformedBy", fields: [performedBy], references: [id])

  @@index([tableName, recordId])
  @@index([performedBy])
  @@index([performedAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  module    String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model DocumentSequence {
  id            String @id @default(uuid()) @db.Uuid
  companyId     String @map("company_id") @db.Uuid
  documentType  String @map("document_type")
  financialYear String @map("financial_year")
  lastSequence  Int    @default(0) @map("last_sequence")

  @@unique([companyId, documentType, financialYear])
  @@map("document_sequences")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  customerCode        String         @unique @map("customer_code")
  customerName        String         @map("customer_name")
  contactPersonName   String?        @map("contact_person_name")
  customerType        CustomerType   @map("customer_type")
  gstNumber           String         @unique @map("gst_number")
  address             String?
  city                String?
  state               String?
  pinCode             String?        @map("pin_code")
  mobile              String?
  email               String?
  assignedSalesUserId String         @map("assigned_sales_user_id") @db.Uuid
  createdById         String         @map("created_by") @db.Uuid
  updatedById         String         @map("updated_by") @db.Uuid
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  assignedSalesUser User              @relation("AssignedSalesExecutive", fields: [assignedSalesUserId], references: [id])
  createdBy         User              @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy         User              @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  contacts          CustomerContact[]
  quotations        Quotation[]
  proformaInvoices  ProformaInvoice[]
  payments          Payment[]
  dispatches        Dispatch[]
  invoiceHandovers  InvoiceHandover[]
  documentationRecords DocumentationRecord[]

  @@index([customerName])
  @@index([city])
  @@index([assignedSalesUserId])
  @@map("customers")
}

model CustomerContact {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  name        String
  designation String?
  mobile      String?
  email       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model ProductTechnology {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_technologies")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  categoryId     String       @map("category_id") @db.Uuid
  brandId        String       @map("brand_id") @db.Uuid
  technologyId   String?      @map("technology_id") @db.Uuid
  capacity       Decimal      @db.Decimal(12, 3)
  capacityUnit   CapacityUnit @map("capacity_unit")
  displayName    String       @map("display_name")
  pricingType    PricingType  @map("pricing_type")
  hsn            String?
  gstRate        Decimal      @map("gst_rate") @db.Decimal(5, 2)
  serialTracking Boolean      @map("serial_tracking")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  category                 ProductCategory           @relation(fields: [categoryId], references: [id])
  brand                    Brand                     @relation(fields: [brandId], references: [id])
  technology               ProductTechnology?        @relation(fields: [technologyId], references: [id])
  prices                   ProductPrice[]
  kitComponents            KitComponent[]            @relation("KitProductComponents")
  componentOfKits          KitComponent[]            @relation("ComponentProductKits")
  inventoryLots            InventoryLot[]
  inventorySerials         InventorySerial[]
  inventoryTransactions    InventoryTransaction[]
  inventoryEvents          InventoryEvent[]
  inventorySafetyStock     InventorySafetyStock[]
  damageReports            InventoryDamageReport[]
  incomingLotChangesProposed IncomingLotChangeRequest[] @relation("IncomingLotChangeProposedProduct")
  incomingLotChangesPrevious IncomingLotChangeRequest[] @relation("IncomingLotChangePreviousProduct")
  transferLines            InventoryTransferLine[]
  crossCompanyPlanLines    PiCrossCompanyTransferPlanLine[]
  quotationItems           QuotationItem[]
  proformaInvoiceItems     ProformaInvoiceItem[]
  dispatchLines            DispatchLine[]
  projectProposalRevisions ProjectProposalRevision[]
  openingAuditLines        InventoryOpeningAuditLine[]
  dailyAuditLines          InventoryDailyAuditLine[]
  purchaseRequestLines     PurchaseRequestLine[]
  manualStockEntries       ManualStockEntry[]

  @@index([displayName])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

/** Sales BOM for Kit products — kits are never stocked; components are fulfilled. */
model KitComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  kitProductId       String  @map("kit_product_id") @db.Uuid
  componentProductId String  @map("component_product_id") @db.Uuid
  qty                Decimal @db.Decimal(12, 3)
  sortOrder          Int     @default(0) @map("sort_order")

  kitProduct       Product @relation("KitProductComponents", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("ComponentProductKits", fields: [componentProductId], references: [id])

  @@unique([kitProductId, componentProductId])
  @@index([kitProductId])
  @@index([componentProductId])
  @@map("kit_components")
}

