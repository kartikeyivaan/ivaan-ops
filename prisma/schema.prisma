  cancelledAt        DateTime?            @map("cancelled_at")
  createdById        String               @map("created_by") @db.Uuid
  updatedById        String?              @map("updated_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  company       Company         @relation(fields: [companyId], references: [id])
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  createdBy     User            @relation("InventoryEventCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?           @relation("InventoryEventUpdatedBy", fields: [updatedById], references: [id])
  replacesEvent InventoryEvent? @relation("InventoryEventReplacement", fields: [replacesEventId], references: [id])
  replacedBy    InventoryEvent[] @relation("InventoryEventReplacement")

  @@index([companyId, warehouseId, productId, effectiveDate])
  @@index([status, eventType])
  @@index([sourceType, sourceId])
  @@index([replacesEventId])
  @@map("inventory_events")
}

model InventorySafetyStock {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  warehouseId   String    @map("warehouse_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  safetyQty     Decimal   @map("safety_qty") @db.Decimal(12, 3)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdById   String    @map("created_by") @db.Uuid
  updatedById   String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  createdBy User      @relation("SafetyStockCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("SafetyStockUpdatedBy", fields: [updatedById], references: [id])

  @@unique([companyId, warehouseId, productId, effectiveFrom])
  @@index([companyId, warehouseId, productId, isActive])
  @@map("inventory_safety_stock")
}

/// weekday: 0=Sunday .. 6=Saturday. isWorking=false marks non-working days.
model CompanyWorkingDay {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  weekday   Int
  isWorking Boolean @default(true) @map("is_working")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekday])
  @@map("company_working_days")
}

model CompanyHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  holidayDate DateTime @map("holiday_date") @db.Date
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, holidayDate])
  @@map("company_holidays")
}

model WarehouseWorkingDay {
  id          String  @id @default(uuid()) @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  weekday     Int
  isWorking   Boolean @default(true) @map("is_working")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, weekday])
  @@map("warehouse_working_days")
}

model WarehouseHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  holidayDate DateTime @map("holiday_date") @db.Date
  name        String?
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, holidayDate])
  @@map("warehouse_holidays")
}

model QuotationWarningLog {
  id          String              @id @default(uuid()) @db.Uuid
  quotationId String              @map("quotation_id") @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  warningType QuotationWarningType @map("warning_type")
  displayed   Boolean             @default(true)
  details     Json?
  proceededById String            @map("proceeded_by") @db.Uuid
  proceededAt DateTime            @default(now()) @map("proceeded_at")

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id])
  proceededBy User      @relation("QuotationWarningProceededBy", fields: [proceededById], references: [id])

  @@index([quotationId])
  @@index([companyId, warningType])
  @@map("quotation_warning_logs")
}

model InvoiceHandover {
  id                String                @id @default(uuid()) @db.Uuid
  dispatchId        String                @unique @map("dispatch_id") @db.Uuid
  companyId         String                @map("company_id") @db.Uuid
  customerId        String                @map("customer_id") @db.Uuid
  status            InvoiceHandoverStatus @default(PENDING_INVOICE)
  invoiceNumber     String?               @map("invoice_number")
  invoiceDate       DateTime?             @map("invoice_date") @db.Date
  remarks           String?
  attachmentUrl     String?               @map("attachment_url")
  recordedById      String?               @map("recorded_by") @db.Uuid
  recordedAt        DateTime?             @map("recorded_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  recordedBy User?    @relation("InvoiceHandoverRecordedBy", fields: [recordedById], references: [id])
  documentation DocumentationRecord?

  @@index([companyId, status])
  @@index([customerId])
  @@map("invoice_handovers")
}

model DocumentationRecord {
  id                   String              @id @default(uuid()) @db.Uuid
  dispatchId           String              @unique @map("dispatch_id") @db.Uuid
  invoiceHandoverId    String              @unique @map("invoice_handover_id") @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  customerId           String              @map("customer_id") @db.Uuid
  status               DocumentationStatus @default(PENDING)
  assignedToId         String?             @map("assigned_to") @db.Uuid
  assignedDate         DateTime?           @map("assigned_date") @db.Date
  completedDate        DateTime?           @map("completed_date") @db.Date
  completedById        String?             @map("completed_by") @db.Uuid
  remarks              String?
  internalNotes        String?             @map("internal_notes")
  holdReason           String?             @map("hold_reason")
  reviewReason         String?             @map("review_reason")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  dispatch        Dispatch                       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  invoiceHandover InvoiceHandover                @relation(fields: [invoiceHandoverId], references: [id], onDelete: Cascade)
  company         Company                        @relation(fields: [companyId], references: [id])
  customer        Customer                       @relation(fields: [customerId], references: [id])
  assignedTo      User?                          @relation("DocumentationAssignedTo", fields: [assignedToId], references: [id])
  completedBy     User?                          @relation("DocumentationCompletedBy", fields: [completedById], references: [id])
  statusHistory   DocumentationStatusHistory[]
  assignmentHistory DocumentationAssignmentHistory[]

  @@index([companyId, status])
  @@index([assignedToId, status])
  @@index([customerId])
  @@map("documentation_records")
}

model DocumentationStatusHistory {
  id                   String              @id @default(uuid()) @db.Uuid
  documentationRecordId String             @map("documentation_record_id") @db.Uuid
  fromStatus           DocumentationStatus? @map("from_status")
  toStatus             DocumentationStatus @map("to_status")
  holdReason           String?             @map("hold_reason")
  reviewReason         String?             @map("review_reason")
  remarks              String?
  changedById          String              @map("changed_by") @db.Uuid
  changedAt            DateTime            @default(now()) @map("changed_at")

  documentationRecord DocumentationRecord @relation(fields: [documentationRecordId], references: [id], onDelete: Cascade)
  changedBy           User                @relation("DocumentationStatusChangedBy", fields: [changedById], references: [id])

  @@index([documentationRecordId, changedAt])
  @@map("documentation_status_history")
}

model DocumentationAssignmentHistory {
  id                    String   @id @default(uuid()) @db.Uuid
  documentationRecordId String   @map("documentation_record_id") @db.Uuid
  fromUserId            String?  @map("from_user_id") @db.Uuid
  toUserId              String?  @map("to_user_id") @db.Uuid
  changedById           String   @map("changed_by") @db.Uuid
  changedAt             DateTime @default(now()) @map("changed_at")
  reason                String?

  documentationRecord DocumentationRecord @relation(fields: [documentationRecordId], references: [id], onDelete: Cascade)
  changedBy           User                @relation("DocumentationAssignmentChangedBy", fields: [changedById], references: [id])

  @@index([documentationRecordId, changedAt])
  @@map("documentation_assignment_history")
}

// ---------------------------------------------------------------------------
// Inventory Audit (Opening Stock + Daily Product Count)
// ---------------------------------------------------------------------------

model InventoryOpeningAudit {
  id           String             @id @default(uuid()) @db.Uuid
  auditNumber  String             @unique @map("audit_number")
  companyId    String             @map("company_id") @db.Uuid
  warehouseId  String             @map("warehouse_id") @db.Uuid
  status       OpeningAuditStatus @default(DRAFT)
  notes        String?
  createdById  String             @map("created_by") @db.Uuid
  submittedAt  DateTime?          @map("submitted_at")
  submittedById String?           @map("submitted_by") @db.Uuid
  approvedAt   DateTime?          @map("approved_at")
  approvedById String?            @map("approved_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  company     Company                     @relation(fields: [companyId], references: [id])
  warehouse   Warehouse                   @relation(fields: [warehouseId], references: [id])
  createdBy   User                        @relation("OpeningAuditCreatedBy", fields: [createdById], references: [id])
  submittedBy User?                       @relation("OpeningAuditSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?                       @relation("OpeningAuditApprovedBy", fields: [approvedById], references: [id])
  lines       InventoryOpeningAuditLine[]

  @@unique([companyId, warehouseId])
  @@index([companyId, status])
  @@map("inventory_opening_audits")
}

model InventoryOpeningAuditLine {
  id          String               @id @default(uuid()) @db.Uuid
  auditId     String               @map("audit_id") @db.Uuid
  productId   String               @map("product_id") @db.Uuid
  condition   OpeningLineCondition @default(GOOD)
  physicalQty Decimal              @default(0) @map("physical_qty") @db.Decimal(12, 3)
  remarks     String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  audit   InventoryOpeningAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  product Product                       @relation(fields: [productId], references: [id])
  serials InventoryOpeningAuditSerial[]

  @@unique([auditId, productId, condition])
  @@index([auditId])
  @@index([productId])
  @@map("inventory_opening_audit_lines")
}

model InventoryOpeningAuditSerial {
  id           String   @id @default(uuid()) @db.Uuid
  lineId       String   @map("line_id") @db.Uuid
  serialNumber String   @map("serial_number")
  createdAt    DateTime @default(now()) @map("created_at")

  line InventoryOpeningAuditLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, serialNumber])
  @@index([serialNumber])
  @@map("inventory_opening_audit_serials")
}

model InventoryDailyAudit {
  id            String           @id @default(uuid()) @db.Uuid
  auditNumber   String           @unique @map("audit_number")
  companyId     String           @map("company_id") @db.Uuid
  warehouseId   String           @map("warehouse_id") @db.Uuid
  auditDate     DateTime         @map("audit_date") @db.Date
  status        DailyAuditStatus @default(DRAFT)
  notes         String?
  createdById   String           @map("created_by") @db.Uuid
  submittedAt   DateTime?        @map("submitted_at")
  submittedById String?          @map("submitted_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  company     Company                   @relation(fields: [companyId], references: [id])
  warehouse   Warehouse                 @relation(fields: [warehouseId], references: [id])
  createdBy   User                      @relation("DailyAuditCreatedBy", fields: [createdById], references: [id])
  submittedBy User?                     @relation("DailyAuditSubmittedBy", fields: [submittedById], references: [id])
  lines       InventoryDailyAuditLine[]

  @@index([companyId, warehouseId, auditDate])
  @@index([companyId, status])
  @@map("inventory_daily_audits")
}

model InventoryDailyAuditLine {
  id          String    @id @default(uuid()) @db.Uuid
  auditId     String    @map("audit_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  systemQty   Decimal   @map("system_qty") @db.Decimal(12, 3)
  physicalQty Decimal?  @map("physical_qty") @db.Decimal(12, 3)
  varianceQty Decimal?  @map("variance_qty") @db.Decimal(12, 3)
  remarks     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  audit   InventoryDailyAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  product Product             @relation(fields: [productId], references: [id])

  @@unique([auditId, productId])
  @@index([auditId])
  @@map("inventory_daily_audit_lines")
}
