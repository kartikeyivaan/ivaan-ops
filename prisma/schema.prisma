generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  APPROVE
  LOGIN
  LOGOUT
}

enum CustomerType {
  DEALER
  PROJECT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PricingType {
  WP
  UNIT
}

enum CapacityUnit {
  WP
  KW
  KVA
  NOS
  METER
}

enum LotStatus {
  INCOMING
  CLOSED
}

enum SerialStatus {
  AVAILABLE
  BOOKED
  DAMAGED
  DISPATCHED
}

enum InventoryTransactionType {
  INWARD
  BOOK
  DISPATCH
  DAMAGE
  TRANSFER
  ADJUST
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  EXPIRED
  CONVERTED
}

enum ProformaInvoiceStatus {
  DRAFT
  ISSUED
  PENDING_BOOKING
  BOOKED
  PARTIALLY_DISPATCHED
  FULLY_DISPATCHED
  CANCELLED
}

enum DispatchStatus {
  DRAFT
  DISPATCHED
  CANCEL_PENDING
  CANCELLED
}

enum PaymentMode {
  BANK_TRANSFER
  CHEQUE
  CASH
  UPI
  NEFT
  RTGS
}

enum ItemApprovalStatus {
  AUTO
  PENDING
  APPROVED
}

enum ApprovalModuleType {
  QUOTATION
  BOOKING
  DC_CANCEL
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  code                 String   @unique
  logoUrl              String?  @map("logo_url")
  digitalSignatureUrl  String?  @map("digital_signature_url")
  address              String?
  city                 String?
  state                String?
  pincode              String?
  phone                String?
  email                String?
  gstNumber            String?  @map("gst_number")
  tagline              String?
  bankDetails          String?  @map("bank_details")
  termsAndConditions   String?  @map("terms_and_conditions")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  warehouses   Warehouse[]
  userCompanies UserCompany[]
  customers    Customer[]
  inventoryLots InventoryLot[]
  inventoryTransactions InventoryTransaction[]
  transfersFrom InventoryTransfer[] @relation("TransferFromCompany")
  transfersTo   InventoryTransfer[] @relation("TransferToCompany")
  quotations    Quotation[]
  proformaInvoices ProformaInvoice[]
  payments      Payment[]
  dispatches    Dispatch[]

  @@map("companies")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String
  email              String     @unique
  mobile             String?
  officialContactNumber String? @map("official_contact_number")
  personalContactNumber String? @map("personal_contact_number")
  digitalVisitingCardUrl String? @map("digital_visiting_card_url")
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  roles              UserRole[]
  companies          UserCompany[]
  auditLogs          AuditLog[]    @relation("AuditPerformedBy")
  notifications      Notification[]
  assignedCustomers  Customer[]    @relation("AssignedSalesExecutive")
  createdCustomers   Customer[]    @relation("CustomerCreatedBy")
  createdLots        InventoryLot[] @relation("LotCreatedBy")
  inventoryTransactions InventoryTransaction[] @relation("TransactionCreatedBy")
  createdTransfers   InventoryTransfer[] @relation("TransferCreatedBy")
  dispatchedTransfers InventoryTransfer[] @relation("TransferDispatchedBy")
  receivedTransfers  InventoryTransfer[] @relation("TransferReceivedBy")
  salesQuotations    Quotation[] @relation("QuotationSalesUser")
  salesProformaInvoices ProformaInvoice[] @relation("ProformaSalesUser")
  bookedProformaInvoices ProformaInvoice[] @relation("ProformaBookedBy")
  recordedPayments   Payment[] @relation("PaymentRecordedBy")
  createdDispatches  Dispatch[] @relation("DispatchCreatedBy")
  dispatchedOrders   Dispatch[] @relation("DispatchDispatchedBy")
  approvalRequests   ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalDecisions  ApprovalRequest[] @relation("ApprovalDecidedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserCompany {
  userId    String @map("user_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_companies")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  inventoryLots InventoryLot[]
  inventorySerials InventorySerial[]
  proformaInvoices ProformaInvoice[]
  dispatches       Dispatch[]

  @@unique([companyId, name])
  @@map("warehouses")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  tableName   String      @map("table_name")
  recordId    String      @map("record_id") @db.Uuid
  action      AuditAction
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
  performedBy String?     @map("performed_by") @db.Uuid
  performedAt DateTime    @default(now()) @map("performed_at")
  companyId   String?     @map("company_id") @db.Uuid
  reference   String?

  performer User? @relation("AuditPerformedBy", fields: [performedBy], references: [id])

  @@index([tableName, recordId])
  @@index([performedBy])
  @@index([performedAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  module    String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model DocumentSequence {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  documentType String @map("document_type")
  financialYear String @map("financial_year")
  lastSequence Int    @default(0) @map("last_sequence")

  @@unique([companyId, documentType, financialYear])
  @@map("document_sequences")
}

model Customer {
  id                   String         @id @default(uuid()) @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  customerCode         String         @map("customer_code")
  customerName         String         @map("customer_name")
  contactPersonName    String?        @map("contact_person_name")
  customerType         CustomerType   @map("customer_type")
  gstNumber            String         @map("gst_number")
  address              String?
  city                 String?
  state                String?
  pinCode              String?        @map("pin_code")
  mobile               String?
  email                String?
  assignedSalesUserId  String         @map("assigned_sales_user_id") @db.Uuid
  createdById          String         @map("created_by") @db.Uuid
  status               CustomerStatus @default(ACTIVE)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  company              Company          @relation(fields: [companyId], references: [id])
  assignedSalesUser    User             @relation("AssignedSalesExecutive", fields: [assignedSalesUserId], references: [id])
  createdBy            User             @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  contacts             CustomerContact[]
  quotations           Quotation[]
  proformaInvoices     ProformaInvoice[]
  payments             Payment[]
  dispatches           Dispatch[]

  @@unique([companyId, customerCode])
  @@unique([companyId, gstNumber])
  @@index([companyId, customerName])
  @@index([companyId, city])
  @@index([assignedSalesUserId])
  @@map("customers")
}

model CustomerContact {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  name         String
  designation  String?
  mobile       String?
  email        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model ProductTechnology {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_technologies")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  categoryId     String       @map("category_id") @db.Uuid
  brandId        String       @map("brand_id") @db.Uuid
  technologyId   String?      @map("technology_id") @db.Uuid
  capacity       Decimal      @db.Decimal(12, 3)
  capacityUnit   CapacityUnit @map("capacity_unit")
  displayName    String       @map("display_name")
  pricingType    PricingType  @map("pricing_type")
  hsn            String?
  gstRate        Decimal      @map("gst_rate") @db.Decimal(5, 2)
  serialTracking Boolean      @map("serial_tracking")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  category   ProductCategory   @relation(fields: [categoryId], references: [id])
  brand      Brand             @relation(fields: [brandId], references: [id])
  technology ProductTechnology? @relation(fields: [technologyId], references: [id])
  prices     ProductPrice[]
  inventoryLots InventoryLot[]
  inventorySerials InventorySerial[]
  inventoryTransactions InventoryTransaction[]
  transferLines InventoryTransferLine[]
  quotationItems QuotationItem[]
  proformaInvoiceItems ProformaInvoiceItem[]
  dispatchLines        DispatchLine[]

  @@index([displayName])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model Vendor {
  id            String   @id @default(uuid()) @db.Uuid
  vendorName    String   @map("vendor_name")
  gst           String?
  address       String?
  contactPerson String?  @map("contact_person")
  mobile        String?
  email         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lots InventoryLot[]

  @@index([vendorName])
  @@map("vendors")
}

model InventoryLot {
  id                  String    @id @default(uuid()) @db.Uuid
  lotNumber           String    @unique @map("lot_number")
  companyId           String    @map("company_id") @db.Uuid
  warehouseId         String    @map("warehouse_id") @db.Uuid
  vendorId            String?   @map("vendor_id") @db.Uuid
  purchaseInvoiceNo   String?   @map("purchase_invoice_no")
  purchaseDate        DateTime  @map("purchase_date") @db.Date
  productId           String    @map("product_id") @db.Uuid
  quantity            Decimal   @db.Decimal(12, 3)
  unitPurchaseRate    Decimal   @default(0) @map("unit_purchase_rate") @db.Decimal(12, 2)
  transportCharges    Decimal   @default(0) @map("transport_charges") @db.Decimal(12, 2)
  commissionCharges   Decimal   @default(0) @map("commission_charges") @db.Decimal(12, 2)
  totalPurchaseCost   Decimal   @default(0) @map("total_purchase_cost") @db.Decimal(14, 2)
  receivedQuantity    Decimal   @default(0) @map("received_quantity") @db.Decimal(12, 3)
  damagedQuantity     Decimal   @default(0) @map("damaged_quantity") @db.Decimal(12, 3)
  status              LotStatus
  createdById         String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id])
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  vendor      Vendor?              @relation(fields: [vendorId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  createdBy   User                 @relation("LotCreatedBy", fields: [createdById], references: [id])
  serials     InventorySerial[]
  transactions InventoryTransaction[]

  @@index([companyId, status])
  @@index([warehouseId])
  @@index([productId])
  @@map("inventory_lots")
}

model InventorySerial {
  id                  String       @id @default(uuid()) @db.Uuid
  lotId               String       @map("lot_id") @db.Uuid
  productId           String       @map("product_id") @db.Uuid
  serialNumber        String       @unique @map("serial_number")
  status              SerialStatus
  currentWarehouseId  String       @map("current_warehouse_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  lot               InventoryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  product           Product      @relation(fields: [productId], references: [id])
  currentWarehouse  Warehouse    @relation(fields: [currentWarehouseId], references: [id])
  transferLineSerials InventoryTransferLineSerial[]
  proformaInvoiceSerials ProformaInvoiceSerial[]
  dispatchLineSerials DispatchLineSerial[]

  @@index([productId, status])
  @@index([currentWarehouseId])
  @@map("inventory_serials")
}

model InventoryTransaction {
  id                String                   @id @default(uuid()) @db.Uuid
  transactionType   InventoryTransactionType @map("transaction_type")
  companyId         String                   @map("company_id") @db.Uuid
  productId         String                   @map("product_id") @db.Uuid
  lotId             String?                  @map("lot_id") @db.Uuid
  qty               Decimal                  @db.Decimal(12, 3)
  fromWarehouseId   String?                  @map("from_warehouse_id") @db.Uuid
  toWarehouseId     String?                  @map("to_warehouse_id") @db.Uuid
  referenceType     String?                  @map("reference_type")
  referenceId       String?                  @map("reference_id") @db.Uuid
  notes             String?
  createdById       String                   @map("created_by") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")

  company     Company       @relation(fields: [companyId], references: [id])
  product     Product       @relation(fields: [productId], references: [id])
  lot         InventoryLot? @relation(fields: [lotId], references: [id])
  createdBy   User          @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, createdAt])
  @@index([productId])
  @@index([lotId])
  @@map("inventory_transactions")
}

model ProductPrice {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  landingCost   Decimal   @map("landing_cost") @db.Decimal(12, 2)
  standardPrice Decimal   @map("standard_price") @db.Decimal(12, 2)
  minimumPrice  Decimal   @map("minimum_price") @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveFrom])
  @@map("product_prices")
}

model InventoryTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  transferNumber  String         @unique @map("transfer_number")
  fromCompanyId   String         @map("from_company_id") @db.Uuid
  toCompanyId     String         @map("to_company_id") @db.Uuid
  fromWarehouseId String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String         @map("to_warehouse_id") @db.Uuid
  status          TransferStatus
  notes           String?
  createdById     String         @map("created_by") @db.Uuid
  dispatchedById  String?        @map("dispatched_by") @db.Uuid
  dispatchedAt    DateTime?      @map("dispatched_at")
  receivedById    String?        @map("received_by") @db.Uuid
  receivedAt      DateTime?      @map("received_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  fromCompany   Company @relation("TransferFromCompany", fields: [fromCompanyId], references: [id])
  toCompany     Company @relation("TransferToCompany", fields: [toCompanyId], references: [id])
  createdBy     User    @relation("TransferCreatedBy", fields: [createdById], references: [id])
  dispatchedBy  User?   @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id])
  receivedBy    User?   @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  lines         InventoryTransferLine[]

  @@index([fromCompanyId, status])
  @@index([toCompanyId, status])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id          String  @id @default(uuid()) @db.Uuid
  transferId  String  @map("transfer_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  qty         Decimal @db.Decimal(12, 3)
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(12, 3)

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  serials  InventoryTransferLineSerial[]

  @@index([transferId])
  @@map("inventory_transfer_lines")
}

model InventoryTransferLineSerial {
  id       String @id @default(uuid()) @db.Uuid
  lineId   String @map("line_id") @db.Uuid
  serialId String @map("serial_id") @db.Uuid

  line   InventoryTransferLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  serial InventorySerial       @relation(fields: [serialId], references: [id])

  @@unique([lineId, serialId])
  @@map("inventory_transfer_line_serials")
}

model Quotation {
  id                String          @id @default(uuid()) @db.Uuid
  quotationNo       String          @unique @map("quotation_no")
  companyId         String          @map("company_id") @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  salesUserId       String          @map("sales_user_id") @db.Uuid
  status            QuotationStatus
  revisionNo        Int             @default(1) @map("revision_no")
  parentQuotationId String?         @map("parent_quotation_id") @db.Uuid
  quotationDate     DateTime        @map("quotation_date") @db.Date
  expiryDate        DateTime        @map("expiry_date") @db.Date
  totalValue        Decimal         @map("total_value") @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  company         Company         @relation(fields: [companyId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  salesUser       User            @relation("QuotationSalesUser", fields: [salesUserId], references: [id])
  parentQuotation Quotation?      @relation("QuotationRevisions", fields: [parentQuotationId], references: [id])
  revisions       Quotation[]     @relation("QuotationRevisions")
  items           QuotationItem[]
  proformaInvoice ProformaInvoice?

  @@index([companyId, status])
  @@index([customerId])
  @@index([parentQuotationId])
  @@map("quotations")
}

model QuotationItem {
  id             String             @id @default(uuid()) @db.Uuid
  quotationId    String             @map("quotation_id") @db.Uuid
  productId      String             @map("product_id") @db.Uuid
  qty            Decimal            @db.Decimal(12, 3)
  rate           Decimal            @db.Decimal(12, 2)
  gstRate        Decimal            @map("gst_rate") @db.Decimal(5, 2)
  lineTotal      Decimal            @map("line_total") @db.Decimal(14, 2)
  approvalStatus ItemApprovalStatus @map("approval_status")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@map("quotation_items")
}

model ApprovalRequest {
  id            String                @id @default(uuid()) @db.Uuid
  moduleType    ApprovalModuleType    @map("module_type")
  moduleId      String                @map("module_id") @db.Uuid
  requestedById String                @map("requested_by") @db.Uuid
  approvedById  String?               @map("approved_by") @db.Uuid
  status        ApprovalRequestStatus
  remarks       String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ApprovalDecidedBy", fields: [approvedById], references: [id])

  @@index([moduleType, moduleId])
  @@index([status])
  @@map("approval_requests")
}

model ProformaInvoice {
  id            String                @id @default(uuid()) @db.Uuid
  piNo          String                @unique @map("pi_no")
  companyId     String                @map("company_id") @db.Uuid
  customerId    String                @map("customer_id") @db.Uuid
  salesUserId   String                @map("sales_user_id") @db.Uuid
  quotationId   String?               @unique @map("quotation_id") @db.Uuid
  warehouseId   String?               @map("warehouse_id") @db.Uuid
  status        ProformaInvoiceStatus
  piDate        DateTime              @map("pi_date") @db.Date
  totalValue    Decimal               @map("total_value") @db.Decimal(14, 2)
  notes         String?
  bookedAt      DateTime?             @map("booked_at")
  bookedById    String?               @map("booked_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  company     Company               @relation(fields: [companyId], references: [id])
  customer    Customer              @relation(fields: [customerId], references: [id])
  salesUser   User                  @relation("ProformaSalesUser", fields: [salesUserId], references: [id])
  quotation   Quotation?            @relation(fields: [quotationId], references: [id])
  warehouse   Warehouse?            @relation(fields: [warehouseId], references: [id])
  bookedBy    User?                 @relation("ProformaBookedBy", fields: [bookedById], references: [id])
  items       ProformaInvoiceItem[]
  payments    Payment[]
  serials     ProformaInvoiceSerial[]
  dispatches  Dispatch[]

  @@index([companyId, status])
  @@index([customerId])
  @@map("proforma_invoices")
}

model ProformaInvoiceItem {
  id            String  @id @default(uuid()) @db.Uuid
  piId          String  @map("pi_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  qty           Decimal @db.Decimal(12, 3)
  dispatchedQty Decimal @default(0) @map("dispatched_qty") @db.Decimal(12, 3)
  rate          Decimal @db.Decimal(12, 2)
  gstRate       Decimal @map("gst_rate") @db.Decimal(5, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(14, 2)

  proformaInvoice ProformaInvoice @relation(fields: [piId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  dispatchLines   DispatchLine[]

  @@index([piId])
  @@map("proforma_invoice_items")
}

model ProformaInvoiceSerial {
  id       String @id @default(uuid()) @db.Uuid
  piId     String @map("pi_id") @db.Uuid
  serialId String @map("serial_id") @db.Uuid

  proformaInvoice ProformaInvoice @relation(fields: [piId], references: [id], onDelete: Cascade)
  serial          InventorySerial @relation(fields: [serialId], references: [id])

  @@unique([piId, serialId])
  @@map("proforma_invoice_serials")
}

model Payment {
  id                String      @id @default(uuid()) @db.Uuid
  companyId         String      @map("company_id") @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  proformaInvoiceId String      @map("proforma_invoice_id") @db.Uuid
  amount            Decimal     @db.Decimal(14, 2)
  paymentDate       DateTime    @map("payment_date") @db.Date
  paymentMode       PaymentMode @map("payment_mode")
  referenceNo       String?     @map("reference_no")
  notes             String?
  recordedById      String      @map("recorded_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")

  company         Company         @relation(fields: [companyId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  proformaInvoice ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id])
  recordedBy      User            @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([proformaInvoiceId])
  @@index([customerId])
  @@index([companyId, paymentDate])
  @@map("payments")
}

model Dispatch {
  id                String         @id @default(uuid()) @db.Uuid
  dcNo              String         @unique @map("dc_no")
  companyId         String         @map("company_id") @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  proformaInvoiceId String         @map("proforma_invoice_id") @db.Uuid
  warehouseId       String         @map("warehouse_id") @db.Uuid
  status            DispatchStatus
  dispatchDate      DateTime       @map("dispatch_date") @db.Date
  vehicleNo         String?        @map("vehicle_no")
  driverName        String?        @map("driver_name")
  notes             String?
  createdById       String         @map("created_by") @db.Uuid
  dispatchedById    String?        @map("dispatched_by") @db.Uuid
  dispatchedAt      DateTime?      @map("dispatched_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  company         Company         @relation(fields: [companyId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  proformaInvoice ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy       User            @relation("DispatchCreatedBy", fields: [createdById], references: [id])
  dispatchedBy    User?           @relation("DispatchDispatchedBy", fields: [dispatchedById], references: [id])
  lines           DispatchLine[]

  @@index([companyId, status])
  @@index([customerId])
  @@index([proformaInvoiceId])
  @@map("dispatches")
}

model DispatchLine {
  id                    String  @id @default(uuid()) @db.Uuid
  dispatchId            String  @map("dispatch_id") @db.Uuid
  proformaInvoiceItemId String  @map("proforma_invoice_item_id") @db.Uuid
  productId             String  @map("product_id") @db.Uuid
  qty                   Decimal @db.Decimal(12, 3)

  dispatch            Dispatch            @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  proformaInvoiceItem ProformaInvoiceItem @relation(fields: [proformaInvoiceItemId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])
  serials             DispatchLineSerial[]

  @@index([dispatchId])
  @@map("dispatch_lines")
}

model DispatchLineSerial {
  id       String @id @default(uuid()) @db.Uuid
  lineId   String @map("line_id") @db.Uuid
  serialId String @map("serial_id") @db.Uuid

  line   DispatchLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  serial InventorySerial @relation(fields: [serialId], references: [id])

  @@unique([lineId, serialId])
  @@map("dispatch_line_serials")
}
