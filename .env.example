# Copy to .env for local development:
#   Copy-Item .env.example .env
#
# Use ONE active DATABASE_URL in .env (local OR Neon dev).
# Keep Neon production URL in Vercel only — never in committed files.

# --- Local PostgreSQL (daily dev on your PC) ---
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/ivaan_ops"
DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/ivaan_ops"

# --- Neon dev branch (optional cloud dev / Vercel preview) ---
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Neon production (Vercel env vars only — do not use in local .env) ---
# DATABASE_URL="postgresql://user:pass@ep-prod-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-prod.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
# Must match the port shown when you run npm run dev
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
