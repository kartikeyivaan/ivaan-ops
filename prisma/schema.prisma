generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  APPROVE
  LOGIN
  LOGOUT
}

enum CustomerType {
  DEALER
  PROJECT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PricingType {
  WP
  UNIT
}

enum CapacityUnit {
  WP
  KW
  KVA
  NOS
  METER
}

model Company {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  code                 String   @unique
  logoUrl              String?  @map("logo_url")
  digitalSignatureUrl  String?  @map("digital_signature_url")
  bankDetails          String?  @map("bank_details")
  termsAndConditions   String?  @map("terms_and_conditions")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  warehouses   Warehouse[]
  userCompanies UserCompany[]
  customers    Customer[]
  productPrices ProductPrice[]

  @@map("companies")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  mobile       String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles              UserRole[]
  companies          UserCompany[]
  auditLogs          AuditLog[]    @relation("AuditPerformedBy")
  notifications      Notification[]
  assignedCustomers  Customer[]    @relation("AssignedSalesExecutive")
  createdCustomers   Customer[]    @relation("CustomerCreatedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserCompany {
  userId    String @map("user_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_companies")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("warehouses")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  tableName   String      @map("table_name")
  recordId    String      @map("record_id") @db.Uuid
  action      AuditAction
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
  performedBy String?     @map("performed_by") @db.Uuid
  performedAt DateTime    @default(now()) @map("performed_at")
  companyId   String?     @map("company_id") @db.Uuid
  reference   String?

  performer User? @relation("AuditPerformedBy", fields: [performedBy], references: [id])

  @@index([tableName, recordId])
  @@index([performedBy])
  @@index([performedAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  module    String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model DocumentSequence {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  documentType String @map("document_type")
  financialYear String @map("financial_year")
  lastSequence Int    @default(0) @map("last_sequence")

  @@unique([companyId, documentType, financialYear])
  @@map("document_sequences")
}

model Customer {
  id                   String         @id @default(uuid()) @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  customerCode         String         @map("customer_code")
  customerName         String         @map("customer_name")
  customerType         CustomerType   @map("customer_type")
  gstNumber            String         @map("gst_number")
  address              String?
  city                 String?
  state                String?
  mobile               String?
  email                String?
  assignedSalesUserId  String         @map("assigned_sales_user_id") @db.Uuid
  createdById          String         @map("created_by") @db.Uuid
  status               CustomerStatus @default(ACTIVE)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  company              Company          @relation(fields: [companyId], references: [id])
  assignedSalesUser    User             @relation("AssignedSalesExecutive", fields: [assignedSalesUserId], references: [id])
  createdBy            User             @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  contacts             CustomerContact[]

  @@unique([companyId, customerCode])
  @@unique([companyId, gstNumber])
  @@index([companyId, customerName])
  @@index([companyId, city])
  @@index([assignedSalesUserId])
  @@map("customers")
}

model CustomerContact {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  name         String
  designation  String?
  mobile       String?
  email        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model ProductTechnology {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_technologies")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  categoryId     String       @map("category_id") @db.Uuid
  brandId        String       @map("brand_id") @db.Uuid
  technologyId   String?      @map("technology_id") @db.Uuid
  capacity       Decimal      @db.Decimal(12, 3)
  capacityUnit   CapacityUnit @map("capacity_unit")
  displayName    String       @map("display_name")
  pricingType    PricingType  @map("pricing_type")
  hsn            String?
  gstRate        Decimal      @map("gst_rate") @db.Decimal(5, 2)
  serialTracking Boolean      @map("serial_tracking")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  category   ProductCategory   @relation(fields: [categoryId], references: [id])
  brand      Brand             @relation(fields: [brandId], references: [id])
  technology ProductTechnology? @relation(fields: [technologyId], references: [id])
  prices     ProductPrice[]

  @@index([displayName])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductPrice {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  landingCost   Decimal   @map("landing_cost") @db.Decimal(12, 2)
  standardPrice Decimal   @map("standard_price") @db.Decimal(12, 2)
  minimumPrice  Decimal   @map("minimum_price") @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([productId, companyId, effectiveFrom])
  @@map("product_prices")
}
